    "LlamaDock app releases come from this project's signed GitHub Releases. This channel never changes the separately managed llama.cpp runtime." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 应用版本来自本项目已签名的 GitHub Releases。此更新渠道不会更改单独管理的 llama.cpp 运行时。"
          }
        }
      }
    },
    "LlamaDock currently downloads public ModelScope repositories without credentials. Private or gated ModelScope repositories are not yet supported." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 目前无需凭据即可下载公开的 ModelScope 仓库，暂不支持私有或受限的 ModelScope 仓库。"
          }
        }
      }
    },
    "LlamaDock currently supports public ModelScope repositories. Choose a public repository to download." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 目前支持公开的 ModelScope 仓库。请选择公开仓库进行下载。"
          }
        }
      }
    },
    "LlamaDock follows macOS Reduce Motion, Increase Contrast, keyboard navigation, and VoiceOver settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 会遵循 macOS 的减弱动态效果、增强对比度、键盘导航和 VoiceOver 设置。"
          }
        }
      }
    },
    "LlamaDock is open-source software. Copyright © LlamaDock contributors." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 是开源软件。版权所有 © LlamaDock 贡献者。"
          }
        }
      }
    },
    "LlamaDock is up to date." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 已是最新版本。"
          }
        }
      }
    },
    "LlamaDock owns only the llama-server process it starts. Quitting the app stops that process and does not install a background daemon." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 只管理由它启动的 llama-server 进程。退出应用会停止该进程，且不会安装后台守护进程。"
          }
        }
      }
    },
    "LlamaDock server %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 服务器%@"
          }
        }
      }
    },
    "LlamaDock stores a security-scoped bookmark and scans GGUF metadata without moving model files." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 会存储安全范围书签并扫描 GGUF 元数据，不会移动模型文件。"
          }
        }
      }
    },
    "LlamaDock will inspect this executable but never overwrite it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LlamaDock 会检查此可执行文件，但绝不会覆盖它。"
          }
        }
      }
    },
    "LlamaDock will move only %@ to the macOS Trash. It will not delete the containing folder or other split/companion files. %@" : {
